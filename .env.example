# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta: usada SOMENTE no servidor (criação de usuários). Nunca exponha no navegador.
SUPABASE_SECRET_KEY=sb_secret_...

# Endereço público do sistema (links nos alertas)
APP_URL=https://seu-sistema.vercel.app
# Segredo do agendador que processa a fila de WhatsApp (gere um valor aleatório longo)
CRON_SECRET=

# WhatsApp Business (Cloud API da Meta) — opcional; sem isso os alertas ficam só no sino
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=pt_BR

# E-mail (Resend) — avisos de assinatura e de pagamento que vence amanhã
RESEND_API_KEY=
# Remetente verificado no Resend (ex.: "Gestão de Obras <avisos@seudominio.com.br>")
EMAIL_FROM=
