{
  "name": "sistema-financeiro-obras",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:integracao": "node --env-file=.env.local --test tests/integracao.test.mjs",
    "db:tipos": "supabase gen types typescript --local > src/lib/database.types.ts",
    "criar-admin": "node --env-file=.env.local scripts/criar-admin.mjs",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "test:nfe": "node --test tests/nfe.test.mts tests/notas-contabeis.test.mts tests/notas-pdf.test.mts tests/comprovantes-banco.test.mts tests/conciliacao.test.mts",
    "test:unit": "node --test tests/*.test.mts tests/nota/*.test.mts",
    "test:gremlins": "node tests/e2e/gremlins.cjs",
    "test:e2e": "bash tests/e2e/rodar.sh",
    "test:personas": "for f in tests/e2e/personas/[a-z]*.cjs; do node $f || exit 1; done",
    "pre-producao": "bash scripts/pre-producao.sh",
    "pre-producao:rapido": "bash scripts/pre-producao.sh --rapido"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tesseract.js-data/por": "^1.0.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.0",
    "next": "16.4.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "gremlins.js": "^2.2.0",
    "supabase": "^2.122.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
